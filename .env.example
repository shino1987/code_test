# Environment Configuration for Minimalist ICT Bot
# Copy this file to .env and fill in your values

# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" for testnet, "false" or omit for mainnet
BINANCE_TESTNET=true

# Telegram Bot (Optional)
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# Note: For production, use a proper .env file loader or export these as environment variables
# Example: export BINANCE_API_KEY="your_key"
